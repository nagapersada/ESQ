        .text-gold { color: #d4af37; }
        .bg-gold { background-color: #d4af37; }
        .border-gold { border-color: #d4af37; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #111; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #d4af37; border-radius: 10px; }

        /* Page Transitions */
        .page {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            transition: opacity 0.5s ease-in-out, visibility 0.5s;
            opacity: 0; visibility: hidden; z-index: 10;
        }
        .page.active {
            opacity: 1; visibility: visible; z-index: 20;
        }

        /* Background Landing Page */
        #landing-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('background.jpg');
            background-size: cover; background-position: center;
            z-index: -2;
        }
        #landing-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75);
            background: linear-gradient(to bottom, rgba(5,5,5,0.6) 0%, rgba(5,5,5,0.95) 100%);
            z-index: -1;
        }

        /* Slide Animation */
        .slide-content { animation: fadeIn 0.4s ease-out forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Pure CSS Animations for Atom & Orbits */
        .orbit-spin {
            animation: spin 8s linear infinite;
        }
        .orbit-spin-reverse {
            animation: spin 12s linear infinite reverse;
        }
        .orbit-spin-slow {
            animation: spin 20s linear infinite;
        }
        @keyframes spin { 
            100% { transform: rotate(360deg); } 
        }

        /* General Slide Formatting */
        .slide-html p { margin-bottom: 1rem; line-height: 1.6; }
        .slide-html ul, .slide-html ol { margin-bottom: 1rem; padding-left: 1.5rem; }
        .slide-html li { margin-bottom: 0.5rem; }
        .highlight { color: #d4af37; font-weight: bold; }
    </style>
</head>
