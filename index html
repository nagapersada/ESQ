                html: `<h3 class="text-xl text-white font-bold mb-8 text-center uppercase tracking-wide">MEMBANGUN MENTAL BERDASARKAN <span class="highlight block mt-2 text-2xl tracking-widest">6 RUKUN IMAN</span></h3>
                
