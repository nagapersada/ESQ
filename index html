            buildToc();
        });

        // Fullscreen API Logic
        function enterFullscreen() {
            let elem = document.documentElement;
            if (elem.requestFullscreen) {
                elem.requestFullscreen().catch(err => console.log(err));
            } else if (elem.webkitRequestFullscreen) { /* Safari */
                elem.webkitRequestFullscreen();
            } else if (elem.msRequestFullscreen) { /* IE11 */
                elem.msRequestFullscreen();
            }
        }

        // Navigation Page 1 & 2
        function goToMainPage() {
            // Memicu fullscreen saat user berinteraksi
            enterFullscreen();
            
            pageLanding.classList.remove('active');
            setTimeout(() => { pageMain.classList.add('active'); }, 300);
        }

        function goToLandingPage() {
            pageMain.classList.remove('active');
            setTimeout(() => { pageLanding.classList.add('active'); }, 300);
        }

        // Render Slide
        function renderSlide(index) {
            if (index < 0 || index >= totalSlides) return;
            currentSlide = index;
            
            // Retrigger CSS animation
            slideContainer.classList.remove('slide-content');
            void slideContainer.offsetWidth; 
            slideContainer.classList.add('slide-content');

            slideContainer.innerHTML = slidesData[index].html;
            slideCounter.innerText = currentSlide + 1;

            btnPrev.disabled = currentSlide === 0;
            btnNext.disabled = currentSlide === totalSlides - 1;
            
            updateTocHighlight();
        }

        function nextSlide() {
            if (currentSlide < totalSlides - 1) {
                renderSlide(currentSlide + 1);
                mainScroll.scrollTop = 0;
            }
        }

        function prevSlide() {
            if (currentSlide > 0) {
                renderSlide(currentSlide - 1);
                mainScroll.scrollTop = 0;
            }
        }

        // Audio Handler
        function toggleAudio() {
            isAudioPlaying = !isAudioPlaying;
            if (isAudioPlaying) {
                iconAudio.classList.replace('fa-play', 'fa-pause');
                btnAudio.classList.add('bg-gold', 'text-black');
                btnAudio.classList.remove('text-gold');
            } else {
                iconAudio.classList.replace('fa-pause', 'fa-play');
                btnAudio.classList.remove('bg-gold', 'text-black');
                btnAudio.classList.add('text-gold');
            }
        }

        // Modal TOC Logic
        function buildToc() {
            let html = '';
            slidesData.forEach((slide, idx) => {
                html += `
                    <button id="toc-btn-${idx}" onclick="goToSlideFromToc(${idx})" class="w-full text-left px-4 py-3 rounded border border-transparent hover:bg-gray-800 transition-colors flex items-center justify-between">
                        <span class="truncate pr-4">${idx + 1}. ${slide.title.replace(/\[Page \d+\] /g, '')}</span>
                        <i id="toc-icon-${idx}" class="fas fa-check text-gold hidden shrink-0"></i>
                    </button>
                `;
            });
            tocList.innerHTML = html;
        }

        function updateTocHighlight() {
            for (let i = 0; i < totalSlides; i++) {
                const btn = document.getElementById(`toc-btn-${i}`);
                const icon = document.getElementById(`toc-icon-${i}`);
                if (!btn) continue;
                if (i === currentSlide) {
                    btn.classList.add('bg-gold/20', 'border-gold', 'text-white');
                    btn.classList.remove('border-transparent');
                    icon.classList.remove('hidden');
                } else {
                    btn.classList.remove('bg-gold/20', 'border-gold', 'text-white');
                    btn.classList.add('border-transparent');
                    icon.classList.add('hidden');
                }
            }
        }

        function openTocModal() {
            modalOverlay.classList.remove('hidden');
            // Allow display block to apply before animating opacity
            requestAnimationFrame(() => {
                modalOverlay.classList.remove('opacity-0');
            });
            
            // Auto scroll TOC to current slide
            setTimeout(() => {
                const activeBtn = document.getElementById(`toc-btn-${currentSlide}`);
                if(activeBtn) activeBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 100);
        }

        function closeModal() {
            modalOverlay.classList.add('opacity-0');
            setTimeout(() => { modalOverlay.classList.add('hidden'); }, 300);
        }

        function goToSlideFromToc(index) {
            closeModal();
            setTimeout(() => {
                renderSlide(index);
                mainScroll.scrollTop = 0;
            }, 300);
        }

        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) closeModal();
        });

        // Swipe Gestures for Mobile
        let touchstartX = 0;
        let touchendX = 0;
        
        mainScroll.addEventListener('touchstart', e => { touchstartX = e.changedTouches[0].screenX; }, {passive: true});
        mainScroll.addEventListener('touchend', e => {
            touchendX = e.changedTouches[0].screenX;
            if (touchendX < touchstartX - 75) nextSlide(); // Swipe left -> Next
            if (touchendX > touchstartX + 75) prevSlide(); // Swipe right -> Prev
        }, {passive: true});

    </script>
</body>
</html>
