            { title: "[Page 32] 7 NILAI DASAR ESQ", html: `<h3 class="text-2xl md:text-3xl text-gold font-black mb-10 text-center tracking-widest uppercase">7 NILAI DASAR ESQ</h3><div class="space-y-4 font-bold text-sm md:text-base max-w-md mx-auto"><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">1. JUJUR</span> <span class="text-gray-400 font-normal">pengabdian kepada AL MU'MIN</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">2. TANGGUNG JAWAB</span> <span class="text-gray-400 font-normal">pengabdian kepada AL WAKIIL</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">3. VISIONER</span> <span class="text-gray-400 font-normal">pengabdian kepada AL AKHIR</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">4. DISIPLIN</span> <span class="text-gray-400 font-normal">pengabdian kepada AL MATIIN</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">5. KERJASAMA</span> <span class="text-gray-400 font-normal">pengabdian kepada AL JAAMI</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gray-800"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">6. ADIL</span> <span class="text-gray-400 font-normal">pengabdian kepada AL 'ADL</span></div><div class="flex flex-col bg-gray-900 p-3 rounded border border-gold/50 shadow-[0_0_10px_rgba(212,175,55,0.1)]"><span class="highlight text-lg border-b border-gray-800 pb-1 mb-1">7. PEDULI</span> <span class="text-gray-400 font-normal">pengabdian kepada AS SAMII' dan AL BASHIR</span></div></div>` },
            { title: "[Page 33] Fitrah Allah", html: `<div class="flex flex-col items-center justify-center h-full min-h-[50vh]"><div class="w-16 h-16 border-2 border-gold rounded-full flex items-center justify-center mb-8 shadow-[0_0_20px_#d4af37]"><i class="fas fa-book-open text-2xl text-gold"></i></div><p class="italic leading-loose text-lg md:text-xl text-center mb-8 text-gray-200 px-4">"Maka hadapkanlah wajahmu dengan mantap kepada agama menurut fitrah Allah yang telah menciptakan fitrah itu pada manusia. Tiada dapat diubah (hukum-hukum) ciptaan Allah. Itulah agama yang benar, Tetapi kebanyakan manusia tiada mengetahui.”</p><span class="text-gray-500 font-bold uppercase tracking-widest text-sm border-b-2 border-gray-700 pb-1">QS Ar Ruum 30:30</span></div>` },
